msgstr "Tiempo límite (segundos)"

#: fprintd-manager:1276
msgid "Total time window for all fingerprint attempts"
msgstr "Tiempo total para todos los intentos de huella"

#: fprintd-manager:1284
msgid "Requires your login password (system files need admin access)"
msgstr ""
"Requiere su contraseña de inicio de sesión (los archivos del sistema "
"necesitan permisos de administrador)"

