"ドライバーを読み込めません — {libraries} がありません（システムの OpenCV が更"
"新された可能性）"

#: fprintd-manager:1689
msgid "Enrolled"
msgstr "登録済み"

#: fprintd-manager:1691
#, python-brace-format
msgid "{count} finger: {names}"
msgid_plural "{count} fingers: {names}"
msgstr[0] "{count} 本: {names}"

#: fprintd-manager:1697
msgid "Not Enrolled"
msgstr "未登録"

#: fprintd-manager:1699
msgid "No fingerprints enrolled — click Enroll to get started"
msgstr "指紋が登録されていません — 「登録」をクリックして始めましょう"
