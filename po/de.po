#: fprintd-manager:1255
msgid "Authentication"
msgstr "Authentifizierung"

#: fprintd-manager:1256
msgid "Fingerprint attempts and timeout before password fallback"
msgstr ""
"Fingerabdruck-Versuche und Zeitlimit, bevor auf das Passwort zurückgegriffen "
"wird"

#: fprintd-manager:1266
msgid "Max Attempts"
msgstr "Maximale Versuche"

#: fprintd-manager:1267
msgid "Number of fingerprint tries before password fallback"
msgstr "Anzahl der Fingerabdruck-Versuche vor dem Passwort"

#: fprintd-manager:1275
msgid "Timeout (seconds)"
msgstr "Zeitlimit (Sekunden)"

#: fprintd-manager:1276
msgid "Total time window for all fingerprint attempts"
msgstr "Gesamtzeit für alle Fingerabdruck-Versuche"

#: fprintd-manager:1284
msgid "Requires your login password (system files need admin access)"
msgstr ""
"Erfordert Ihr Anmeldepasswort (Systemdateien benötigen Administratorrechte)"

#: fprintd-manager:1287 fprintd-manager:1316 fprintd-manager:1341
msgid "Apply PAM Settings"
msgstr "PAM-Einstellungen anwenden"

#: fprintd-manager:1300 fprintd-manager:1409
msgid "Applying…"
msgstr "Wird angewendet …"

#: fprintd-manager:1318
msgid ""
"Nothing enabled yet — turn on a switch under “Where to Use Fingerprint”; "
"these settings apply with it"
msgstr ""
"Noch nichts aktiviert — schalten Sie unter „Wo der Fingerabdruck verwendet "
"wird“ einen Schalter ein; diese Einstellungen gelten dann mit"

#: fprintd-manager:1344
#, python-brace-format
