[Desktop Entry]
Type=Application
Name=fprintd Fingerprint Manager
Comment=Manage fingerprints using fprintd
Name[de]=fprintd Fingerabdruck-Verwaltung
Name[es]=Gestor de huellas fprintd
Name[fr]=Gestionnaire d’empreintes fprintd
Name[ja]=fprintd 指紋マネージャー
Name[zh_CN]=fprintd 指纹管理器
Comment[de]=Fingerabdrücke mit fprintd verwalten
Comment[es]=Gestione huellas dactilares con fprintd
Comment[fr]=Gérer les empreintes digitales avec fprintd
Comment[ja]=fprintd を使用して 指紋を登録・管理します
Comment[zh_CN]=使用 fprintd 管理指纹
Exec=fprintd-manager
TryExec=fprintd-manager
Icon=dialog-password
Terminal=false
Categories=Settings;HardwareSettings;
Keywords=fingerprint;scanner;fprintd;biometric;
Keywords[de]=Fingerabdruck;Scanner;fprintd;biometrisch;
Keywords[es]=huella;lector;fprintd;biométrico;
Keywords[fr]=empreinte;lecteur;fprintd;biométrie;
Keywords[ja]=指紋;スキャナー;fprintd;生体認証;
Keywords[zh_CN]=指纹;扫描器;fprintd;生物识别;
